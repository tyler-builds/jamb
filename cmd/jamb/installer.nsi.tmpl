; Generated by jamb package from jamb.json. Edit jamb.json, not this script.
;
; The installer is per-user: it installs to %LOCALAPPDATA%\Programs without an
; administrator prompt, and it writes only to HKCU and the user's Start menu and
; desktop. It runs silently with /S and into another folder with /D=PATH.

Unicode true
RequestExecutionLevel user
ManifestDPIAware true
SetCompressor /SOLID lzma

!include "MUI2.nsh"

Name "{{nsis .DisplayName}}"
OutFile "{{nsis .OutFile}}"
InstallDir "$LOCALAPPDATA\Programs\{{nsis .DisplayName}}"
InstallDirRegKey HKCU "{{nsis .UninstallKey}}" "InstallLocation"

!define MUI_ICON "{{nsis .Icon}}"
!define MUI_UNICON "{{nsis .Icon}}"
!define MUI_ABORTWARNING

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

VIProductVersion "{{.WinVersion}}"
VIAddVersionKey /LANG=1033 "ProductName" "{{nsis .DisplayName}}"
VIAddVersionKey /LANG=1033 "CompanyName" "{{nsis .Publisher}}"
VIAddVersionKey /LANG=1033 "FileDescription" "{{nsis .DisplayName}} Setup"
VIAddVersionKey /LANG=1033 "FileVersion" "{{.WinVersion}}"
{{- if .Copyright}}
VIAddVersionKey /LANG=1033 "LegalCopyright" "{{nsis .Copyright}}"
{{- end}}

Section "{{nsis .DisplayName}}" SecMain
  SectionIn RO
  SetShellVarContext current
  SetOutPath "$INSTDIR"
  SetOverwrite on

  File "{{nsis .ExePath}}"
  {{- range .Files}}
  File "{{nsis .Path}}"
  {{- end}}
  WriteUninstaller "$INSTDIR\uninstall.exe"

  CreateDirectory "$SMPROGRAMS\{{nsis .DisplayName}}"
  CreateShortcut "$SMPROGRAMS\{{nsis .DisplayName}}\{{nsis .DisplayName}}.lnk" "$INSTDIR\{{nsis .Executable}}"
  CreateShortcut "$SMPROGRAMS\{{nsis .DisplayName}}\Uninstall {{nsis .DisplayName}}.lnk" "$INSTDIR\uninstall.exe"

  WriteRegStr HKCU "{{nsis .UninstallKey}}" "DisplayName" "{{nsis .DisplayName}}"
  WriteRegStr HKCU "{{nsis .UninstallKey}}" "DisplayVersion" "{{nsis .Version}}"
  WriteRegStr HKCU "{{nsis .UninstallKey}}" "Publisher" "{{nsis .Publisher}}"
  WriteRegStr HKCU "{{nsis .UninstallKey}}" "Comments" "{{nsis .Description}}"
  WriteRegStr HKCU "{{nsis .UninstallKey}}" "DisplayIcon" "$INSTDIR\{{nsis .Executable}}"
  WriteRegStr HKCU "{{nsis .UninstallKey}}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "{{nsis .UninstallKey}}" "UninstallString" "$\"$INSTDIR\uninstall.exe$\""
  WriteRegStr HKCU "{{nsis .UninstallKey}}" "QuietUninstallString" "$\"$INSTDIR\uninstall.exe$\" /S"
  WriteRegDWORD HKCU "{{nsis .UninstallKey}}" "EstimatedSize" {{.EstimatedSize}}
  WriteRegDWORD HKCU "{{nsis .UninstallKey}}" "NoModify" 1
  WriteRegDWORD HKCU "{{nsis .UninstallKey}}" "NoRepair" 1
SectionEnd

Section /o "Desktop shortcut" SecDesktop
  SetShellVarContext current
  CreateShortcut "$DESKTOP\{{nsis .DisplayName}}.lnk" "$INSTDIR\{{nsis .Executable}}"
SectionEnd

Section "Uninstall"
  SetShellVarContext current

  Delete "$DESKTOP\{{nsis .DisplayName}}.lnk"
  Delete "$SMPROGRAMS\{{nsis .DisplayName}}\{{nsis .DisplayName}}.lnk"
  Delete "$SMPROGRAMS\{{nsis .DisplayName}}\Uninstall {{nsis .DisplayName}}.lnk"
  RMDir "$SMPROGRAMS\{{nsis .DisplayName}}"

  Delete "$INSTDIR\{{nsis .Executable}}"
  {{- range .Files}}
  Delete "$INSTDIR\{{nsis .Name}}"
  {{- end}}
  Delete "$INSTDIR\uninstall.exe"
  RMDir "$INSTDIR"

  DeleteRegKey HKCU "{{nsis .UninstallKey}}"
SectionEnd
